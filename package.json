{
  "name": "ody",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:dashboard": "turbo run dev --filter=@ody/dashboard",
    "dev:backend": "turbo run dev --filter=@ody/backend",
    "gen:api": "orval --config orval.config.ts",
    "gen:contract": "orval --config orval.config.ts",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "echo 'Tests not configured yet'"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "orval": "^7.9.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.21.0"
  }
}
