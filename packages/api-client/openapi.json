{
  "openapi": "3.0.0",
  "info": {
    "title": "Ody Restaurant API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "displayOrder": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "displayOrder",
          "createdAt",
          "updatedAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "CreateCategory": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "displayOrder": {
            "type": "integer"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCategory": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "displayOrder": {
            "type": "integer"
          }
        }
      },
      "DeleteResult": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "message",
          "id"
        ]
      },
      "MenuItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "string"
          },
          "isAvailable": {
            "type": "boolean"
          },
          "stockQuantity": {
            "type": "integer",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "categoryId",
          "name",
          "description",
          "price",
          "isAvailable",
          "stockQuantity",
          "imageUrl",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateMenuItem": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "string",
            "minLength": 1
          },
          "isAvailable": {
            "type": "boolean"
          },
          "stockQuantity": {
            "type": "integer",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "categoryId",
          "name",
          "price"
        ]
      },
      "UpdateMenuItem": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "string",
            "minLength": 1
          },
          "isAvailable": {
            "type": "boolean"
          },
          "stockQuantity": {
            "type": "integer",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          },
          "orderType": {
            "type": "string",
            "enum": [
              "dine_in",
              "pickup",
              "delivery"
            ]
          },
          "subtotal": {
            "type": "string"
          },
          "tax": {
            "type": "string"
          },
          "total": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "customerId",
          "status",
          "orderType",
          "subtotal",
          "tax",
          "total",
          "notes",
          "createdAt",
          "completedAt",
          "updatedAt"
        ]
      },
      "CreateOrderItem": {
        "type": "object",
        "properties": {
          "menuItemId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "menuItemId",
          "quantity"
        ]
      },
      "CreateOrder": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderItem"
            },
            "minItems": 1
          },
          "notes": {
            "type": "string"
          },
          "orderType": {
            "type": "string",
            "enum": [
              "dine_in",
              "pickup",
              "delivery"
            ]
          }
        },
        "required": [
          "customerId",
          "items"
        ]
      },
      "OrderCustomer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone"
        ]
      },
      "OrderLineMenuItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "OrderLineItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "menuItemId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer"
          },
          "priceAtTime": {
            "type": "string"
          },
          "subtotal": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "menuItem": {
            "$ref": "#/components/schemas/OrderLineMenuItem"
          }
        },
        "required": [
          "id",
          "menuItemId",
          "quantity",
          "priceAtTime",
          "subtotal",
          "notes",
          "menuItem"
        ]
      },
      "OrderWithDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Order"
          },
          {
            "type": "object",
            "properties": {
              "customer": {
                "$ref": "#/components/schemas/OrderCustomer"
              },
              "orderItems": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OrderLineItem"
                }
              }
            },
            "required": [
              "customer",
              "orderItems"
            ]
          }
        ]
      },
      "UpdateOrderStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CustomerOrderSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          },
          "orderType": {
            "type": "string",
            "enum": [
              "dine_in",
              "pickup",
              "delivery"
            ]
          },
          "total": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "status",
          "orderType",
          "total",
          "createdAt"
        ]
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "totalOrders": {
            "type": "integer"
          },
          "totalSpent": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "totalOrders",
          "totalSpent",
          "createdAt"
        ]
      },
      "CustomerListItem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Customer"
          },
          {
            "type": "object",
            "properties": {
              "recentOrders": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CustomerOrderSummary"
                }
              }
            },
            "required": [
              "recentOrders"
            ]
          }
        ]
      },
      "CustomerDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Customer"
          },
          {
            "type": "object",
            "properties": {
              "orders": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CustomerOrderSummary"
                }
              }
            },
            "required": [
              "orders"
            ]
          }
        ]
      },
      "PopularItem": {
        "type": "object",
        "properties": {
          "menuItemId": {
            "type": "string",
            "format": "uuid"
          },
          "menuItemName": {
            "type": "string"
          },
          "orderCount": {
            "type": "integer"
          }
        },
        "required": [
          "menuItemId",
          "menuItemName",
          "orderCount"
        ]
      },
      "DashboardStats": {
        "type": "object",
        "properties": {
          "totalRevenue": {
            "type": "string"
          },
          "totalOrders": {
            "type": "integer"
          },
          "pendingOrders": {
            "type": "integer"
          },
          "completedToday": {
            "type": "integer"
          },
          "averageOrderValue": {
            "type": "string"
          },
          "popularItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PopularItem"
            }
          }
        },
        "required": [
          "totalRevenue",
          "totalOrders",
          "pendingOrders",
          "completedToday",
          "averageOrderValue",
          "popularItems"
        ]
      },
      "RestaurantSettings": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "restaurantName": {
            "type": "string"
          },
          "prepTimeMinutes": {
            "type": "integer"
          },
          "autoAcceptOrders": {
            "type": "boolean"
          },
          "serviceAvailable": {
            "type": "boolean"
          },
          "taxRate": {
            "type": "string"
          },
          "openingTime": {
            "type": "string",
            "nullable": true
          },
          "closingTime": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "restaurantName",
          "prepTimeMinutes",
          "autoAcceptOrders",
          "serviceAvailable",
          "taxRate",
          "openingTime",
          "closingTime",
          "updatedAt"
        ]
      },
      "UpdateRestaurantSettings": {
        "type": "object",
        "properties": {
          "restaurantName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "prepTimeMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 120
          },
          "autoAcceptOrders": {
            "type": "boolean"
          },
          "serviceAvailable": {
            "type": "boolean"
          },
          "taxRate": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{4}$"
          },
          "openingTime": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$"
          },
          "closingTime": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$"
          }
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/categories": {
      "get": {
        "tags": [
          "Categories"
        ],
        "summary": "List all categories",
        "responses": {
          "200": {
            "description": "All menu categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Categories"
        ],
        "summary": "Create a category",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCategory"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Category created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/categories/{id}": {
      "get": {
        "tags": [
          "Categories"
        ],
        "summary": "Get a category",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Category found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "404": {
            "description": "Category not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Categories"
        ],
        "summary": "Update a category",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCategory"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Category updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Category not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Categories"
        ],
        "summary": "Delete a category",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Category deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResult"
                }
              }
            }
          },
          "404": {
            "description": "Category not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/menu-items": {
      "get": {
        "tags": [
          "Menu Items"
        ],
        "summary": "List menu items",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Optional category filter"
            },
            "required": false,
            "name": "categoryId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Menu items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MenuItem"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Menu Items"
        ],
        "summary": "Create a menu item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMenuItem"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Menu item created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/menu-items/{id}": {
      "get": {
        "tags": [
          "Menu Items"
        ],
        "summary": "Get a menu item",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Menu item found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            }
          },
          "404": {
            "description": "Menu item not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Menu Items"
        ],
        "summary": "Update a menu item",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMenuItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Menu item updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Menu item not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Menu Items"
        ],
        "summary": "Delete a menu item",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Menu item deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResult"
                }
              }
            }
          },
          "404": {
            "description": "Menu item not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
